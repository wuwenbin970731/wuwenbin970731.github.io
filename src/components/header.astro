---
import Link from '@/components/link.astro'
import ThemeToggle from '@/components/theme-toggle.astro'
import { NAV_LINKS, SITE } from '@/consts'
---

<div>
  <div
    class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3"
  >
    <Link href="/" class="flex shrink-0 items-center justify-center gap-2.5">
      <img
        src="/static/logo-wenbin.png"
        alt=""
        aria-hidden="true"
        class="size-6 rounded-md object-cover ring-1 ring-primary/20"
      />
      <span
        class="brand-wordmark hidden h-full text-base leading-none min-[360px]:block"
        style="font-family: Georgia, 'Times New Roman', ui-serif, serif; font-weight: 700; letter-spacing: 0; color: transparent; background: linear-gradient(105deg, color-mix(in oklab, var(--foreground) 86%, var(--primary)), var(--primary) 48%, color-mix(in oklab, var(--accent-lilac) 78%, var(--foreground))); background-clip: text; -webkit-background-clip: text; text-wrap: nowrap;"
        >{SITE.title}</span
      >
    </Link>
    <div class="flex items-center gap-4">
      <nav class="flex items-center gap-4 text-sm sm:gap-6">
        {
          NAV_LINKS.map((item) => (
            <Link
              href={item.href}
              class="text-muted-foreground hover:text-primary capitalize transition-colors"
            >
              {item.label}
            </Link>
          ))
        }
      </nav>
      <ThemeToggle transition:persist />
    </div>
  </div>
</div>
